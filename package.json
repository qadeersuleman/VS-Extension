{
  "name": "qadeer-companion",
  "displayName": "Qadeer — Islamic Companion",
  "description": "Personalized Islamic companion and productivity workspace for Qadeer: Quran ayat, Asma-ul-Husna, daily azkar, Naats, Songs, and Reminders.",
  "version": "1.0.0",
  "publisher": "qadeer",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "islamic",
    "quran",
    "asma-ul-husna",
    "naats",
    "reminders",
    "azkar",
    "productivity"
  ],
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onView:noor.sidebar"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qadeer",
          "title": "Qadeer",
          "icon": "media/noor.svg"
        }
      ]
    },
    "views": {
      "noor": [
        {
          "type": "webview",
          "id": "noor.sidebar",
          "name": "Qadeer Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "noor.openSidebar",
        "title": "Qadeer: Open Islamic Companion"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.26.0"
  }
}
